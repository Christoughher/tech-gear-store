# Public project URL. This is not the PostgreSQL connection string.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Backend secret from Supabase Dashboard -> Project Settings -> API.
# Never put this key in assets/js, HTML, screenshots, chat, or Git.
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SERVICE_ROLE_KEY

# Must exactly match the project ref inside SUPABASE_URL.
# This guard prevents the script from writing to the wrong project.
DEMO_CONFIRM_PROJECT_REF=YOUR_PROJECT_REF

# Shared password for newly-created demo accounts. Use at least 12 characters.
DEMO_USER_PASSWORD=REPLACE_WITH_A_STRONG_DEMO_PASSWORD

# Changing this changes deterministic assignments while keeping exact quotas.
DEMO_SEED=20260722

# Optional. Omit to use today's date in Asia/Ho_Chi_Minh.
# DEMO_ANCHOR_DATE=2026-07-22

